{
  "rules": {
    ".read": false,
    ".write": false,

    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",

        "documents": {
          "$docId": {
            ".validate": "newData.hasChildren(['id', 'type', 'title', 'createdAt', 'updatedAt'])",

            "id": {
              ".validate": "newData.isString() && newData.val() === $docId"
            },
            "type": {
              ".validate": "newData.isString() && (newData.val() === 'notebook' || newData.val() === 'sketch')"
            },
            "title": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 200"
            },
            "favorite": {
              ".validate": "newData.isBoolean()"
            },
            "trashed": {
              ".validate": "newData.isBoolean()"
            },
            "trashedAt": {
              ".validate": "newData.val() === null || newData.isNumber()"
            },
            "createdAt": {
              ".validate": "newData.isNumber() || newData.val() === now"
            },
            "updatedAt": {
              ".validate": "newData.isNumber() || newData.val() === now"
            },
            "tags": {
              "$index": {
                ".validate": "newData.isString()"
              }
            },
            "category": {
              ".validate": "newData.val() === null || newData.isString()"
            },
            "cover": {
              "kind": {
                ".validate": "newData.isString() && (newData.val() === 'color' || newData.val() === 'gradient')"
              },
              "value": {
                ".validate": "newData.isString()"
              }
            },

            "template": {
              ".validate": "newData.isString()"
            },
            "paperSize": {
              ".validate": "newData.isString()"
            },
            "orientation": {
              ".validate": "newData.val() === 'portrait' || newData.val() === 'landscape'"
            },
            "pageCount": {
              ".validate": "newData.isNumber() && newData.val() >= 0"
            },

            "width": {
              ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 8000"
            },
            "height": {
              ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 8000"
            },
            "transparentBackground": {
              ".validate": "newData.isBoolean()"
            },
            "backgroundColor": {
              ".validate": "newData.isString()"
            },

            "$other": {
              ".validate": false
            }
          }
        },

        "profile": {
          ".validate": "newData.hasChildren()"
        },
        "settings": {
          ".validate": "newData.hasChildren()"
        }
      }
    }
  }
}
